<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Miniatura del video -->
    <ImageView
        android:id="@+id/thumbnailImage"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:background="@android:color/black"
        android:scaleType="centerCrop"
        android:contentDescription="Miniatura del video"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Título y descripción -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/thumbnailImage"
        app:layout_constraintBottom_toBottomOf="@id/thumbnailImage"
        app:layout_constraintStart_toEndOf="@id/thumbnailImage"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/videoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título del video"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/videoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del video"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>