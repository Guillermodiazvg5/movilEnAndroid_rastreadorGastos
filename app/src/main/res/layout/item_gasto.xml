<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:padding="15dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <!-- Emoji de categoría -->
    <TextView
        android:id="@+id/gastoEmoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="🍔"
        android:textSize="22sp" />

    <!-- Nombre, categoria, fecha y descripcion -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/gastoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Almuerzo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/gastoDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comida · 15/09/2026 14:30"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/gastoDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textStyle="italic"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Monto -->
    <TextView
        android:id="@+id/gastoMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-$25.000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FF5252"
        android:layout_marginEnd="10dp" />

    <!-- Botón eliminar -->
    <TextView
        android:id="@+id/btnEliminar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="🗑️"
        android:textSize="18sp" />

</LinearLayout>